<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadRelay"
        Width="1120" Height="860" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#090D17" Foreground="#F3FAF6"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3FAF6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8BCBA"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#7F9491"/>
        <SolidColorBrush x:Key="Accent" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="CardFill" Color="#0BFFFFFF"/>
        <SolidColorBrush x:Key="CardStroke" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="Inset" Color="#2E000000"/>
        <SolidColorBrush x:Key="InsetStroke" Color="#12FFFFFF"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#101517"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#17FFFFFF"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090D17" Offset="0"/>
                <GradientStop Color="#0E1728" Offset="0.55"/>
                <GradientStop Color="#0A111F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-240,-260,0,0" Opacity="0.16" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2DD4BF" Offset="0"/>
                    <GradientStop Color="#002DD4BF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-220,-240" Opacity="0.13" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#006366F1" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="Dashboard" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2DD4BF" Offset="0"/>
                            <GradientStop Color="#0EA5A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#2DD4BF"/>
                    </Border.Effect>
                    <TextBlock Text="🎮" FontFamily="Segoe UI Emoji" FontSize="25"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PadRelay" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Razer Kishi V2 · wireless bridge to Windows" FontSize="13.5"
                               Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Height="30" CornerRadius="15" Padding="12,0"
                            Background="#1A2DD4BF" BorderBrush="#332DD4BF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#2DD4BF" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Stopped" FontSize="12.5" FontWeight="Medium"
                                       Foreground="#2DD4BF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ModelVisibility" Style="{StaticResource IconButton}" Margin="12,0,0,0">
                        <Grid Width="20" Height="20">
                            <Path Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5" Data="M1,10 Q10,-2 19,10 Q10,22 1,10 Z"/>
                            <Ellipse Width="5" Height="5" Fill="{StaticResource TextPrimary}"/>
                            <Path x:Name="ModelEyeSlash" Stroke="{StaticResource TextPrimary}" StrokeThickness="2" Data="M2,2 L18,18"/>
                        </Grid>
                    </Button>
                    <Button x:Name="RestartButton" Content="↻" Style="{StaticResource IconButton}"
                            Margin="12,0,0,0" ToolTip="Restart with a new pairing code"/>
                    <Button x:Name="StartButton" Content="▶  Start receiver" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pairing" Style="{StaticResource PanelTitle}"/>
                            </StackPanel>

                            <TextBlock Text="PAIRING CODE" Style="{StaticResource FieldLabel}" Margin="0,16,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PairingCode" Text="------" FontFamily="Consolas" FontSize="52"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" LineHeight="62"/>
                                <Button x:Name="QrButton" IsEnabled="False" Width="40" Height="40" Padding="8"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                        ToolTip="Show pairing QR code" AutomationProperties.Name="Show pairing QR code">
                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Accent}"
                                          Data="F0 M0,0H9V9H0Z M2,2H7V7H2Z M3,3H6V6H3Z M12,0H21V9H12Z M14,2H19V7H14Z M15,3H18V6H15Z M0,12H9V21H0Z M2,14H7V19H2Z M3,15H6V18H3Z M12,12H16V16H12Z M18,12H21V15H18Z M16,16H20V19H16Z M12,18H15V21H12Z"/>
                                </Button>
                            </StackPanel>
                            <Popup x:Name="QrPopup" PlacementTarget="{Binding ElementName=QrButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Background="White" CornerRadius="8" Padding="8">
                                    <Image x:Name="PairQrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="Pairing QR code"/>
                                </Border>
                            </Popup>
                            <TextBlock Text="Tap the QR icon beside the pairing code on the phone, or enter the address and code. Then tap Connect."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WINDOWS IP" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="AddressText" Text="Unavailable" FontFamily="Consolas"
                                                   FontSize="14.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                        <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource GhostButton}"
                                                Margin="6,0,0,0" ToolTip="Copy address"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="PORT" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="26760" FontFamily="Consolas" FontSize="14.5" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Ellipse x:Name="PairingStatusDot" Width="7" Height="7" Fill="#40FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PairingStatus" Text="Receiver is not listening" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CharacterCard" Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="EnterFullscreen" DockPanel.Dock="Right" Content="Fullscreen"
                                        Style="{StaticResource SecondaryButton}" ToolTip="Fullscreen (F11)"/>
                                <TextBlock x:Name="CharacterName" Text="Character" Style="{StaticResource PanelTitle}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            </DockPanel>
                            <Button x:Name="ChooseModel" Content="Choose model ▾" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <Border x:Name="PreviewHost" Height="206" Margin="0,6">
                            <Viewport3D x:Name="WukongPreview" ClipToBounds="True">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="WukongCamera" Position="0,4,8" LookDirection="0,-2,-8" UpDirection="0,1,0" FieldOfView="49"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#999999"/>
                                            <DirectionalLight Color="#FFF2D6" Direction="-1,-1,-2"/>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                                <ModelVisual3D x:Name="WukongFloor"/>
                                <ModelVisual3D x:Name="WukongImpact"/>
                                <ModelVisual3D x:Name="SpinTrail"/>
                                <ModelVisual3D x:Name="Wukong">
                                    <ModelVisual3D.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D CenterY="1.65">
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="WukongFlip" Axis="1,0,0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="WukongYaw" Axis="0,1,0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <TranslateTransform3D x:Name="WukongMove"/>
                                        </Transform3DGroup>
                                    </ModelVisual3D.Transform>
                                </ModelVisual3D>
                            </Viewport3D>
                            </Border>
                            <UniformGrid Columns="2">
                                <Button x:Name="JumpButton" Content="A · Jump" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="FightButton" Content="X · Fight" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="SlamButton" Content="Y · Slam" ToolTip="Draw staff and slam (I)" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="DodgeButton" Content="B · Dodge" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="SpinButton" Content="RT · Spin" ToolTip="360° swing (U)" Style="{StaticResource SecondaryButton}"/>
                                <CheckBox x:Name="RunToggle" Content="RB · Run" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                            </UniformGrid>
                            <TextBlock x:Name="WukongHint" Text="Left stick to walk · Right stick to orbit"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,6,0,0"/>
                            <Button x:Name="ResetCamera" Content="Reset camera" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="∿" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live input" Style="{StaticResource PanelTitle}"/>
                                    <Button x:Name="Player1" Content="P1" Margin="8,0,0,0" Style="{StaticResource GhostButton}" ToolTip="Inspect Player 1"/>
                                    <Button x:Name="Player2" Content="P2" Style="{StaticResource GhostButton}" ToolTip="Inspect Player 2"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#33FFFFFF" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="LiveText" Text="No phone" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Canvas x:Name="LeftStick" Tag="Left" Background="Transparent" Cursor="Hand" Width="112" Height="112">
                                        <Ellipse Width="112" Height="112" Fill="#08FFFFFF" Stroke="#1FFFFFFF" StrokeThickness="1"/>
                                        <Line X1="56" Y1="10" X2="56" Y2="102" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                        <Line X1="10" Y1="56" X2="102" Y2="56" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                        <Ellipse x:Name="LeftDot" Width="16" Height="16" Fill="#2DD4BF" Canvas.Left="48" Canvas.Top="48">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.55" Color="#2DD4BF"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                    <TextBlock Text="Left stick" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="LeftValues" Text="0  0" FontFamily="Consolas" FontSize="9.5"
                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="LT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="LTPercent" Text="0%" FontFamily="Consolas" FontSize="9.5"
                                                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid x:Name="LTTrack" Height="9" Margin="0,4,0,0">
                                        <Border Background="#0EFFFFFF" CornerRadius="5"/>
                                        <Border x:Name="LTFill" Width="0" HorizontalAlignment="Left" Background="#2DD4BF" CornerRadius="5"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="RT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="RTPercent" Text="0%" FontFamily="Consolas" FontSize="9.5"
                                                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid x:Name="RTTrack" Height="9" Margin="0,4,0,0">
                                        <Border Background="#0EFFFFFF" CornerRadius="5"/>
                                        <Border x:Name="RTFill" Width="0" HorizontalAlignment="Left" Background="#2DD4BF" CornerRadius="5"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="D-PAD" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border x:Name="DpadUp" Width="22" Height="22" CornerRadius="4" Background="#0BFFFFFF"
                                                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="3,0">
                                                <TextBlock Text="↑" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="DpadLeft" Width="22" Height="22" CornerRadius="4" Background="#0BFFFFFF"
                                                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="3,0">
                                                <TextBlock Text="←" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="DpadDown" Width="22" Height="22" CornerRadius="4" Background="#0BFFFFFF"
                                                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="3,0">
                                                <TextBlock Text="↓" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="DpadRight" Width="22" Height="22" CornerRadius="4" Background="#0BFFFFFF"
                                                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="3,0">
                                                <TextBlock Text="→" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Canvas x:Name="RightStick" Tag="Right" Background="Transparent" Cursor="Hand" Width="112" Height="112">
                                        <Ellipse Width="112" Height="112" Fill="#08FFFFFF" Stroke="#1FFFFFFF" StrokeThickness="1"/>
                                        <Line X1="56" Y1="10" X2="56" Y2="102" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                        <Line X1="10" Y1="56" X2="102" Y2="56" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                        <Ellipse x:Name="RightDot" Width="16" Height="16" Fill="#2DD4BF" Canvas.Left="48" Canvas.Top="48">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.55" Color="#2DD4BF"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                    <TextBlock Text="Right stick" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="RightValues" Text="0  0" FontFamily="Consolas" FontSize="9.5"
                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                            <UniformGrid x:Name="ButtonGrid" Columns="6" Rows="2"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="250" MaxWidth="360"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Receiver" Style="{StaticResource PanelTitle}"/>
                                    </StackPanel>

                                    <Border Background="#0EFFFFFF" CornerRadius="8" Padding="3" Margin="0,5,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="GamepadButton" Content="Gamepad" Style="{StaticResource ModeButton}"
                                                    Background="#2DD4BF" Foreground="#101517"/>
                                            <Button x:Name="MonitorButton" Grid.Column="1" Content="Monitor" Style="{StaticResource ModeButton}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="ModeDetail" Text="Publishes an Xbox 360 controller through ViGEmBus."
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>

                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock x:Name="GamepadStatusIcon" Text="●" FontSize="12" Foreground="#F5C56B" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="GamepadStatus" Text="The virtual controller is created when the receiver starts."
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <Border x:Name="GamepadWarning" Visibility="Collapsed" Background="#12F59E0B" CornerRadius="10"
                                            Padding="11" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Virtual gamepad unavailable" FontSize="12" FontWeight="SemiBold" Foreground="#F5C56B"/>
                                            <TextBlock x:Name="GamepadWarningText" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="PeerText" Text="No phone connected" FontSize="10.5"
                                               Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="≡" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activity" Style="{StaticResource PanelTitle}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Grid.Row="1" Background="{StaticResource Inset}" BorderBrush="{StaticResource InsetStroke}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
                                    <RichTextBox x:Name="ActivityBox" IsReadOnly="True" IsTabStop="False" BorderThickness="0"
                                                 Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" Padding="10">
                                        <FlowDocument PagePadding="0"/>
                                    </RichTextBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="FullscreenOverlay" Background="#090D17" Visibility="Collapsed">
            <Border x:Name="FullscreenHost"/>
            <Button x:Name="FullscreenChooseModel" Content="Choose model ▾" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"/>
            <Button x:Name="ExitFullscreen" Content="Exit fullscreen (Esc)" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"/>
        </Grid>
    </Grid>
</Window>
